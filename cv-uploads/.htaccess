# Nega qualunque accesso web ai CV.
# Questa cartella deve stare FUORI dalla web root; questo .htaccess
# è una protezione aggiuntiva nel caso finisse comunque sotto Apache.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
